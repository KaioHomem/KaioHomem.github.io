# Modelo. Copie para .env e preencha — .env está no .gitignore e NUNCA é commitado.
#
# ATENÇÃO: nada aqui vai para o navegador. Se um valor precisa ser lido pelo
# JavaScript do cliente, ele NÃO é secreto — é público por definição, mesmo em
# repositório privado. Ver SEGURANCA.md.

# --- Público (vai ao HTML de propósito, não é segredo) ---
ADSENSE_PUBLISHER_ID=
GA4_MEASUREMENT_ID=
GOOGLE_OAUTH_CLIENT_ID=

# --- Secreto (só servidor; nunca no cliente) ---
GOOGLE_OAUTH_CLIENT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
META_PAGE_ACCESS_TOKEN=
ANTHROPIC_API_KEY=
